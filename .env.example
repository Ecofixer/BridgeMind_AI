# Required only for generative chat and voice transcription.
OPENAI_API_KEY=

# Model choices are configuration, never hard-coded business rules.
OPENAI_MODEL=gpt-5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

# Local-only runtime state.
FOUNDER_AI_DATA_DIR=.local
FOUNDER_AI_DEFAULT_CONVERSATION_ID=founder-main

# Safe default: personal/company memories stay local and are not sent to a cloud model.
FOUNDER_AI_ALLOW_CLOUD_MEMORY_CONTEXT=false
