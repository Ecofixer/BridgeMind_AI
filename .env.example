# Optional. Without a key the app runs in local safe mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe

FOUNDER_AI_DATA_DIR=.local
FOUNDER_AI_DEFAULT_CONVERSATION_ID=founder-main
FOUNDER_AI_TIMEZONE=Asia/Taipei

# Privacy-safe default: structured profile and long-term memory stay local.
FOUNDER_AI_ALLOW_CLOUD_MEMORY_CONTEXT=false
